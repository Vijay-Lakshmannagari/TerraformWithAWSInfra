main.tf
--------------------------------
resource "aws_s3_bucket" "example" {
  bucket = var.mybucket

}

------------------------------------
variables.tf
------------------------------------
variable "mybucket" {
  type        = string
  description = "This is my DevOps test bucket from TF"
  default     = ""

}

